# Public upstreams. HTTPS is enforced unless ALLOW_INSECURE_HTTP=1 for local tests.
TECHNOCORE_URL=https://technocore.chat
BINANCE_URL=https://api.binance.com

# Generate a fresh unlisted mailbox: mb-p- followed by a long random value.
MAILBOX_ROOM=mb-p-replace-with-at-least-128-random-bits

# Only these signed User DIDs can trigger the Host. Separate multiple DIDs with commas.
ALLOWED_USER_DIDS=did:key:z6MkREPLACE_WITH_THE_BROWSER_USER_DID

# Keep the seed and SQLite state on the VPS. Never put the seed in Vercel.
HOST_SEED_FILE=/var/lib/signal-id-agent/host.seed
AGENT_STATE_PATH=/var/lib/signal-id-agent/agent.sqlite3

WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
POLL_WAIT=10
REQUEST_TIMEOUT=20
LOG_LEVEL=INFO

# Zero disables reports. A non-zero value posts a signed report into the mailbox.
REPORT_INTERVAL_MINUTES=0

# Optional comma-separated threshold rules. Symbols must exist in WATCHLIST.
PRICE_ALERTS=
ALERT_CHECK_SECONDS=60
ALERT_COOLDOWN_MINUTES=60
